# Placeholders only. Copy to .env and fill in. Never commit .env.
# Variable names are our own convention (Bible D-020).

SONAR_ENV=dev
DATABASE_URL=postgresql+psycopg://sonar:sonar@localhost:55432/sonar
TEST_DATABASE_URL=postgresql+psycopg://sonar:sonar@localhost:55432/sonar_test
POSTGRES_PORT=55432

# Created in Phase 1 (spike S-1). Leave empty until then.
SONAR_ACCESS_KEY=
WEBHOOK_SECRET_TOKEN=
BOLNA_API_KEY=
BOLNA_API_BASE_URL=https://api.bolna.ai
BOLNA_AGENT_ID_PHARMACY=
BOLNA_AGENT_ID_COMPUTER_REPAIR=
# Agent for searches with the user's own questions (docs/agent/prompt_general_v1.md, D-062)
BOLNA_AGENT_ID_GENERAL=
BOLNA_FROM_PHONE_NUMBER=
# A verified TEAM phone for the Phase 1 spike (E.164). Never a shop. Put it in .env, not here.
SPIKE_TEST_PHONE=

BUSINESS_SEED_PATH=data/businesses.local.yaml

# Optional, frontend only (public by construction, never put a secret here). Overrides the map tile
# server; the default is OpenStreetMap's public tiles, which are for light use only.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Wave 2 flags (Bible section 56). All off until M1.
FEATURE_STOP_RULE=false
FEATURE_HISTORY=false
FEATURE_DIGEST=false
FEATURE_SHOP_LINE=false
FEATURE_LIVE_TICKER=false
LIVE_MIN_PULL_SECONDS=2
FEATURE_AUDIO_REPLAY=false
FEATURE_VOICE_UI=false
FEATURE_COMPILER=false
FEATURE_WATCHES=false
FEATURE_CACHE_REUSE=false

# Map, discovery and shop self opt-in (D-059..D-061)
FEATURE_DISCOVERY=false
FEATURE_OPT_IN=false
OVERPASS_URL=https://overpass-api.de/api/interpreter
PUBLIC_BASE_URL=http://localhost:8000
OPT_IN_TOKEN_DAYS=14

# The user's own questions on every call (D-062); off by default
FEATURE_CUSTOM_QUESTIONS=false
